# Freshdesk tenant. API keys are supplied by MCP clients with Authorization: Bearer <api-key>.
FRESHDESK_DOMAIN=yourcompany.freshdesk.com

# Runtime logging
LOG_LEVEL=INFO

# Local MCP clients usually use stdio. Remote hosts should use sse or streamable-http behind Nginx.
# MCP_TRANSPORT=sse serves both /sse (Cursor, Claude) and /mcp (Codex) on the same port.
MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional comma-separated tool controls. Leave blank to expose all tools.
ENABLED_MCP_TOOLS=
DISABLED_MCP_TOOLS=create_agent,update_agent,create_contact_field,list_companies,view_company,search_companies,find_company_by_name,list_company_fields,list_groups,create_group,view_group,update_group,list_solution_categories,view_solution_category,create_solution_category,update_solution_category,list_solution_folders,create_solution_category_folder,view_solution_category_folder,update_solution_category_folder,list_solution_articles,create_solution_article,view_solution_article,update_solution_article,create_ticket_field,delete_ticket_summary
